# Servidor
PORT=3000
NODE_ENV=development

# Segurança da sessão (troque em produção)
SESSION_SECRET=troque-este-segredo-na-vercel

# URL pública usada nos QR Codes. Em branco, o sistema usa o host da requisição.
PUBLIC_APP_URL=

# Cadastro público entra como ativo por padrão. Use false para exigir aprovação do SuperAdmin.
SIGNUP_AUTO_APPROVE=true

# Senha das contas de demonstração
DEMO_PASSWORD=Demo@1234

# Caminho do SQLite local (não se aplica ao Vercel; lá o banco é efêmero em memória)
DATABASE_FILE=./data/plastikkimik.sqlite
