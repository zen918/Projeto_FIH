# ------------------------------------------------------------------
# Servidor
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3333
# Origens permitidas no CORS (separe por vírgula)
CORS_ORIGIN=http://localhost:5173
# URL pública do frontend usada nos links e QR Codes de rastreio
PUBLIC_APP_URL=http://localhost:5173
# Segredo usado para assinar os tokens do modo demonstração
JWT_SECRET=troque-este-segredo-em-producao

# ------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------
# Deixe DEMO_MODE=true para rodar sem Supabase (dados em memória).
# Ao configurar um projeto real, preencha as chaves e use DEMO_MODE=false.
DEMO_MODE=true

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Buckets do Storage (criados pelo schema.sql)
SUPABASE_AVATARS_BUCKET=avatars
SUPABASE_EVIDENCE_BUCKET=evidencias-lotes

# Novas contas entram como ativas automaticamente (true) ou aguardam
# aprovação de um SuperAdmin (false). Recomendado: false em produção.
SIGNUP_AUTO_APPROVE=true
