<%
  const canManage = ['pesquisador_lab', 'superadmin'].includes(currentUser.role);
  const metrics = [
    { label: 'Pétalas de origem', value: kg(batch.petalsKg, 1), icon: 'bi-flower1' },
    { label: 'Bioplástico produzido', value: kg(batch.weightProducedKg, 1), icon: 'bi-box-seam' },
    { label: 'Reservado em pedidos', value: kg(batch.reservedKg, 1), icon: 'bi-bag-check' },
    { label: 'Disponível', value: kg(batch.availableKg, 1), icon: 'bi-check2-circle' },
  ];
%>

<div class="page-head">
  <div>
    <span class="eyebrow">Rastreabilidade do lote</span>
    <h1 class="page-title"><%= batch.batchCode %></h1>
    <p class="page-subtitle"><%= batch.formulaVersion %> · origem <%= batch.floristOrganization %>, <%= batch.floristCity %>.</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a class="btn btn-outline-secondary" href="/app/lotes"><i class="bi bi-arrow-left me-1"></i> Voltar</a>
    <% if (canManage && nextStatus) { %>
      <form action="/app/lotes/<%= batch.id %>/status" method="POST">
        <button class="btn btn-brand" type="submit">
          <i class="bi bi-arrow-right-circle me-1"></i> <%= nextLabel %>
        </button>
      </form>
    <% } %>
  </div>
</div>

<div class="row g-3 g-xl-4">
  <div class="col-lg-7">
    <article class="panel-card">
      <div class="panel-head">
        <div>
          <span class="eyebrow">Ficha do lote</span>
          <h2>Dados de produção</h2>
        </div>
        <%- include('../../partials/status-badge', { status: batch.status }) %>
      </div>

      <div class="row g-3">
        <% metrics.forEach(function (metric) { %>
          <div class="col-6">
            <div class="mini-stat">
              <span class="mini-stat-icon"><i class="bi <%= metric.icon %>"></i></span>
              <strong><%= metric.value %></strong>
              <span><%= metric.label %></span>
            </div>
          </div>
        <% }); %>
      </div>

      <h3 class="detail-title">Origem e processo</h3>
      <dl class="detail-list">
        <div><dt>Floricultura</dt><dd><%= batch.floristOrganization %> · <%= batch.floristCity %></dd></div>
        <div><dt>Responsável técnico</dt><dd><%= batch.researcherOrganization %></dd></div>
        <div><dt>Peso de pétalas coletado</dt><dd><%= kg(batch.petalsKg, 1) %> (<%= qualityLabel(batch.qualityStatus) %>)</dd></div>
        <div><dt>Data da retirada</dt><dd><%= date(batch.pickupDate) %></dd></div>
        <div><dt>Código de rastreio</dt><dd><code><%= batch.traceCode %></code></dd></div>
        <div><dt>Tempo de biodegradação</dt><dd><%= batch.biodegradationDays %> dias</dd></div>
        <div><dt>Resistência mecânica</dt><dd><%= batch.tensileStrength ? `${number(batch.tensileStrength, 1)} MPa` : 'Não informada' %></dd></div>
        <div><dt>Criado em</dt><dd><%= dateTime(batch.createdAt) %></dd></div>
      </dl>

      <% if (batch.collectionNotes) { %>
        <div class="info-note mt-3">
          <i class="bi bi-chat-left-text"></i>
          <span><%= batch.collectionNotes %></span>
        </div>
      <% } %>
    </article>

    <article class="panel-card mt-3 mt-xl-4">
      <div class="panel-head compact">
        <div>
          <span class="eyebrow">Relações comerciais</span>
          <h2>Pedidos deste lote</h2>
        </div>
        <span class="count-bubble"><%= orders.length %></span>
      </div>
      <% if (orders.length) { %>
        <div class="table-responsive">
          <table class="table app-table align-middle mb-0">
            <thead>
              <tr><th>Cliente</th><th>Volume</th><th>Formato</th><th>Status</th></tr>
            </thead>
            <tbody>
              <% orders.forEach(function (order) { %>
                <tr>
                  <td><strong><%= order.clientOrganization %></strong><small class="d-block text-secondary"><%= order.clientCity %></small></td>
                  <td><%= kg(order.quantityKg, 1) %></td>
                  <td><%= packagingLabel(order.packagingType) %></td>
                  <td><%- include('../../partials/status-badge', { status: order.status }) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-inline"><i class="bi bi-bag"></i> Nenhum pedido vinculado a este lote ainda.</div>
      <% } %>
    </article>
  </div>

  <div class="col-lg-5">
    <article class="panel-card qr-card">
      <div class="d-flex align-items-center justify-content-between">
        <span class="eyebrow">QR público</span>
        <span class="verified-pill"><i class="bi bi-patch-check-fill"></i> Verificado</span>
      </div>
      <div class="qr-frame">
        <% if (qrDataUrl) { %>
          <img src="<%= qrDataUrl %>" alt="QR Code do lote <%= batch.traceCode %>" width="240" height="240" />
        <% } %>
      </div>
      <p class="qr-code-text">Código <code><%= batch.traceCode %></code></p>
      <p class="text-secondary small text-center">
        Aponte a câmera para abrir a página pública com origem, fórmula e impacto do lote.
      </p>
      <div class="d-grid gap-2">
        <a class="btn btn-brand" href="<%= publicTraceUrl %>" target="_blank" rel="noreferrer">
          <i class="bi bi-box-arrow-up-right me-1"></i> Abrir página pública
        </a>
        <a class="btn btn-outline-secondary" href="/r/<%= batch.traceCode %>/qr.png?download=1">
          <i class="bi bi-download me-1"></i> Baixar QR Code PNG
        </a>
      </div>
    </article>

    <article class="panel-card mt-3 mt-xl-4">
      <div class="panel-head compact">
        <div>
          <span class="eyebrow">Cadeia</span>
          <h2>Linha do tempo</h2>
        </div>
      </div>
      <div class="timeline-list">
        <div class="timeline-item">
          <span class="timeline-dot tone-petal"></span>
          <div><strong>Coleta sinalizada</strong><small><%= kg(batch.petalsKg, 1) %> · <%= date(batch.collectionCreatedAt) %></small></div>
        </div>
        <div class="timeline-item">
          <span class="timeline-dot tone-sage"></span>
          <div><strong>Lote produzido</strong><small><%= batch.formulaVersion %> · <%= date(batch.createdAt) %></small></div>
        </div>
        <div class="timeline-item">
          <span class="timeline-dot <%= batch.status === 'em_producao' ? 'tone-amber' : 'tone-sky' %>"></span>
          <div><strong><%= statusLabel(batch.status) %></strong><small>Atualizado em <%= dateTime(batch.updatedAt) %></small></div>
        </div>
      </div>
    </article>
  </div>
</div>
