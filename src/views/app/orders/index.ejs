<%
  const actionLabels = {
    em_analise: 'Iniciar análise',
    aprovado: 'Aprovar pedido',
    em_producao: 'Iniciar produção',
    entregue: 'Confirmar entrega',
  };
  const statusOptions = [
    { value: '', label: 'Todos' },
    { value: 'solicitado', label: 'Solicitado' },
    { value: 'em_analise', label: 'Em análise' },
    { value: 'aprovado', label: 'Aprovado' },
    { value: 'em_producao', label: 'Em produção' },
    { value: 'entregue', label: 'Entregue' },
    { value: 'cancelado', label: 'Cancelado' },
  ];
  const canManage = ['pesquisador_lab', 'superadmin'].includes(currentUser.role);
%>

<div class="page-head">
  <div>
    <span class="eyebrow"><%= isClient ? 'Relações comerciais' : 'Gestão de pedidos' %></span>
    <h1 class="page-title">Pedidos B2B</h1>
    <p class="page-subtitle">
      <%= isClient
        ? 'Acompanhe seus pedidos de bioplástico e comprove o impacto no selo verde.'
        : 'Analise, aprove e acompanhe a entrega dos pedidos de bioplástico.' %>
    </p>
  </div>
  <% if (isClient) { %>
    <a class="btn btn-brand" href="/app/pedidos/novo"><i class="bi bi-plus-lg me-1"></i> Novo pedido</a>
  <% } %>
</div>

<div class="row g-3">
  <div class="col-6 col-xl-3">
    <article class="metric-card metric-card-sm">
      <div class="metric-top"><span class="metric-icon tone-petal"><i class="bi bi-bag"></i></span></div>
      <strong><%= kg(summary.contractedKg, 1) %></strong>
      <span>Volume contratado</span>
      <small><%= summary.total %> pedidos registrados</small>
    </article>
  </div>
  <div class="col-6 col-xl-3">
    <article class="metric-card metric-card-sm">
      <div class="metric-top"><span class="metric-icon tone-amber"><i class="bi bi-hourglass-split"></i></span></div>
      <strong><%= integer(summary.active) %></strong>
      <span>Pedidos ativos</span>
      <small>Aguardando ou em produção</small>
    </article>
  </div>
  <div class="col-6 col-xl-3">
    <article class="metric-card metric-card-sm">
      <div class="metric-top"><span class="metric-icon tone-sky"><i class="bi bi-gear-wide-connected"></i></span></div>
      <strong><%= integer(summary.producing) %></strong>
      <span>Em produção</span>
      <small>Volume sendo preparado</small>
    </article>
  </div>
  <div class="col-6 col-xl-3">
    <article class="metric-card metric-card-sm">
      <div class="metric-top"><span class="metric-icon tone-sage"><i class="bi bi-truck"></i></span></div>
      <strong><%= integer(summary.delivered) %></strong>
      <span>Entregues</span>
      <small>Pedidos concluídos</small>
    </article>
  </div>
</div>

<article class="panel-card mt-3 mt-xl-4">
  <div class="panel-head">
    <div>
      <span class="eyebrow">Histórico</span>
      <h2><%= isClient ? 'Meus pedidos' : 'Todos os pedidos' %></h2>
    </div>
    <form class="filter-form" action="/app/pedidos" method="GET">
      <select class="form-select form-select-sm" name="status" onchange="this.form.submit()" aria-label="Filtrar por status">
        <% statusOptions.forEach(function (option) { %>
          <option value="<%= option.value %>" <%= status === option.value ? 'selected' : '' %>><%= option.label %></option>
        <% }); %>
      </select>
    </form>
  </div>

  <% if (orders.length) { %>
    <div class="order-list">
      <% orders.forEach(function (order) { %>
        <article class="order-card">
          <div class="order-main">
            <div class="order-head">
              <span class="batch-code"><i class="bi bi-box-seam"></i> <%= order.batchCode %></span>
              <%- include('../../partials/status-badge', { status: order.status }) %>
            </div>
            <h3><%= kg(order.quantityKg, 1) %> de <%= packagingLabel(order.packagingType).toLowerCase() %></h3>
            <p class="order-meta">
              <%= isClient ? order.formulaVersion : `${order.clientOrganization} · ${order.clientCity}` %>
              <span>·</span>
              solicitado <%= timeAgo(order.createdAt) %>
            </p>
            <% if (order.notes) { %>
              <p class="order-notes"><i class="bi bi-chat-left-text"></i> <%= order.notes %></p>
            <% } %>
          </div>

          <div class="order-side">
            <div class="order-side-row">
              <span>Fórmula</span>
              <strong><%= order.formulaVersion %></strong>
            </div>
            <div class="order-side-row">
              <span>Rastreio</span>
              <a href="/r/<%= order.traceCode %>" target="_blank" rel="noreferrer"><code><%= order.traceCode %></code> <i class="bi bi-arrow-up-right"></i></a>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
              <% if (canManage && actionLabels[order.status]) { %>
                <form action="/app/pedidos/<%= order.id %>/status" method="POST" class="flex-grow-1">
                  <button class="btn btn-sm btn-brand-soft w-100" type="submit"><%= actionLabels[order.status] %></button>
                </form>
              <% } %>
              <% if (!['entregue', 'cancelado'].includes(order.status)) { %>
                <form action="/app/pedidos/<%= order.id %>/status" method="POST" onsubmit="return confirm('Cancelar este pedido?');">
                  <input type="hidden" name="action" value="cancel" />
                  <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-x-lg"></i></button>
                </form>
              <% } %>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="bi bi-bag-check"></i>
      <h3>Nenhum pedido encontrado</h3>
      <p><%= isClient ? 'Faça seu primeiro pedido de bioplástico rastreado.' : 'Ajuste o filtro para ver outros status.' %></p>
      <% if (isClient) { %>
        <a class="btn btn-brand" href="/app/pedidos/novo"><i class="bi bi-plus-lg me-1"></i> Novo pedido</a>
      <% } %>
    </div>
  <% } %>
</article>
