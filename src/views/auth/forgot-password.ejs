<section class="auth-section">
  <div class="container">
    <div class="auth-card auth-card-narrow">
      <div class="auth-form-col">
        <div class="auth-form-inner">
          <a class="back-link" href="/login"><i class="bi bi-arrow-left"></i> Voltar para o login</a>
          <span class="eyebrow mt-3">Recuperação de acesso</span>
          <h1 class="auth-form-title">Esqueceu a senha?</h1>
          <p class="text-secondary mb-4">
            Informe o e-mail cadastrado. Em produção, enviaríamos um link seguro por e-mail.
            Nesta demonstração, o link aparece na própria tela.
          </p>

          <form action="/recuperar-senha" method="POST" class="auth-form">
            <div class="mb-3">
              <label class="form-label" for="email">E-mail</label>
              <div class="input-icon">
                <i class="bi bi-envelope"></i>
                <input class="form-control" id="email" name="email" type="email" placeholder="voce@empresa.com" value="<%= locals.email || '' %>" required />
              </div>
            </div>
            <button class="btn btn-brand w-100" type="submit">Gerar link de redefinição</button>
          </form>

          <% if (resetLink) { %>
            <div class="reset-link-box mt-4">
              <p class="fw-semibold mb-1"><i class="bi bi-check-circle me-1"></i> Link de demonstração gerado</p>
              <p class="small text-secondary mb-2">Válido por 1 hora. Em produção, este link seria enviado por e-mail.</p>
              <a class="btn btn-outline-secondary btn-sm text-break" href="<%= resetLink %>"><%= resetLink %></a>
            </div>
          <% } else if (locals.email) { %>
            <div class="alert alert-info mt-4 mb-0 small">
              Se o e-mail estiver cadastrado, o link de redefinição aparecerá aqui.
            </div>
          <% } %>

          <div class="demo-hint mt-4">
            <i class="bi bi-lightbulb"></i>
            <span>No demo, use a senha <code><%= demoPassword %></code> nas contas de demonstração.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
