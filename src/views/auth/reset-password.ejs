<section class="auth-section">
  <div class="container">
    <div class="auth-card auth-card-narrow">
      <div class="auth-form-col">
        <div class="auth-form-inner">
          <a class="back-link" href="/login"><i class="bi bi-arrow-left"></i> Voltar para o login</a>
          <span class="eyebrow mt-3">Nova credencial</span>
          <h1 class="auth-form-title">Definir nova senha</h1>
          <p class="text-secondary mb-4">
            Escolha uma senha com pelo menos 8 caracteres, incluindo letras e números.
          </p>

          <form action="/redefinir-senha/<%= token %>" method="POST" class="auth-form">
            <div class="mb-3">
              <label class="form-label" for="password">Nova senha</label>
              <input class="form-control" id="password" name="password" type="password" placeholder="Sua nova senha" required minlength="8" />
            </div>
            <div class="mb-3">
              <label class="form-label" for="passwordConfirm">Confirmar nova senha</label>
              <input class="form-control" id="passwordConfirm" name="passwordConfirm" type="password" placeholder="Repita a nova senha" required minlength="8" />
            </div>
            <button class="btn btn-brand w-100" type="submit">Salvar nova senha</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
