<div class="flash-stack" aria-live="polite">
  <% flash.forEach(function (message) { %>
    <div class="alert alert-<%= message.type %> alert-dismissible fade show shadow-sm" role="alert">
      <i class="bi <%= message.type === 'success' ? 'bi-check-circle' : message.type === 'danger' ? 'bi-exclamation-octagon' : message.type === 'warning' ? 'bi-exclamation-triangle' : 'bi-info-circle' %> me-1"></i>
      <%= message.message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  <% }); %>
</div>
