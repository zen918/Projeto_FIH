<aside class="app-sidebar d-none d-lg-flex" id="appSidebar">
  <div class="sidebar-head">
    <a class="brand brand-light" href="/app">
      <span class="brand-mark"><i class="bi bi-flower1"></i></span>
      <span class="brand-text"><strong>Plastikkimik</strong><small>PYTANGY</small></span>
    </a>
    <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-label="Recolher menu">
      <i class="bi bi-layout-sidebar-inset"></i>
    </button>
  </div>

  <div class="sidebar-body">
    <p class="sidebar-label">Navegação</p>
    <nav class="sidebar-nav">
      <% navItems.forEach(function (item) { %>
        <a class="sidebar-link <%= isActive(item.to) ? 'active' : '' %>" href="<%= item.to %>" title="<%= item.label %>">
          <i class="bi <%= item.icon %>"></i>
          <span><%= item.label %></span>
        </a>
      <% }); %>
    </nav>

    <% if (quickAction && currentUser.role !== 'superadmin') { %>
      <a class="sidebar-cta" href="<%= quickAction.to %>">
        <span class="sidebar-cta-icon"><i class="bi bi-plus-lg"></i></span>
        <span><%= quickAction.label %></span>
      </a>
    <% } %>
  </div>

  <div class="sidebar-foot">
    <div class="sidebar-user">
      <%- include('avatar', { name: currentUser.fullName, src: currentUser.avatarUrl, size: 'sm' }) %>
      <div class="sidebar-user-text">
        <strong><%= currentUser.fullName %></strong>
        <small><%= roleShort(currentUser.role) %></small>
      </div>
    </div>
    <span class="demo-chip">Demonstração</span>
  </div>
</aside>

<div class="offcanvas offcanvas-start app-offcanvas d-lg-none" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
  <div class="offcanvas-header">
    <a class="brand brand-light" href="/app" id="mobileSidebarLabel">
      <span class="brand-mark"><i class="bi bi-flower1"></i></span>
      <span class="brand-text"><strong>Plastikkimik</strong><small>PYTANGY</small></span>
    </a>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
  </div>
  <div class="offcanvas-body">
    <p class="sidebar-label">Navegação</p>
    <nav class="sidebar-nav">
      <% navItems.forEach(function (item) { %>
        <a class="sidebar-link <%= isActive(item.to) ? 'active' : '' %>" href="<%= item.to %>">
          <i class="bi <%= item.icon %>"></i>
          <span><%= item.label %></span>
        </a>
      <% }); %>
    </nav>
    <% if (quickAction) { %>
      <a class="sidebar-cta" href="<%= quickAction.to %>">
        <span class="sidebar-cta-icon"><i class="bi bi-plus-lg"></i></span>
        <span><%= quickAction.label %></span>
      </a>
    <% } %>
    <div class="mt-auto pt-4">
      <div class="sidebar-user">
        <%- include('avatar', { name: currentUser.fullName, src: currentUser.avatarUrl, size: 'sm' }) %>
        <div class="sidebar-user-text">
          <strong><%= currentUser.fullName %></strong>
          <small><%= roleShort(currentUser.role) %></small>
        </div>
      </div>
      <form action="/logout" method="POST" class="mt-3">
        <button class="btn btn-outline-light btn-sm w-100" type="submit">
          <i class="bi bi-box-arrow-right me-1"></i> Sair da conta
        </button>
      </form>
    </div>
  </div>
</div>
