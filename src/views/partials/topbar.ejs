<header class="app-topbar">
  <div class="topbar-left">
    <button class="icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-label="Abrir navegação">
      <i class="bi bi-list"></i>
    </button>
    <button class="icon-btn d-none d-lg-inline-flex" type="button" data-sidebar-toggle aria-label="Alternar menu lateral">
      <i class="bi bi-layout-sidebar-inset"></i>
    </button>
    <div class="topbar-title">
      <span><%= pageEyebrow || 'Plataforma' %></span>
      <strong><%= pageTitle %></strong>
    </div>
  </div>

  <div class="topbar-right">
    <span class="demo-pill d-none d-md-inline-flex">
      <span class="pulse-dot"></span> Modo demonstração
    </span>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Alternar tema">
      <i class="bi bi-sun-fill theme-icon-light"></i>
      <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
    </button>

    <div class="dropdown">
      <button class="user-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <%- include('avatar', { name: currentUser.fullName, src: currentUser.avatarUrl, size: 'sm' }) %>
        <span class="user-trigger-text d-none d-md-flex">
          <strong><%= currentUser.fullName %></strong>
          <small><%= roleShort(currentUser.role) %></small>
        </span>
        <i class="bi bi-chevron-down user-chevron"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end user-dropdown">
        <li class="px-3 pt-2 pb-2 border-bottom">
          <div class="d-flex align-items-center gap-2">
            <%- include('avatar', { name: currentUser.fullName, src: currentUser.avatarUrl, size: 'sm' }) %>
            <div class="min-w-0">
              <div class="fw-semibold text-truncate"><%= currentUser.fullName %></div>
              <div class="small text-secondary text-truncate"><%= currentUser.email %></div>
            </div>
          </div>
          <span class="badge-role mt-2"><%= roleLabel(currentUser.role) %></span>
        </li>
        <li><a class="dropdown-item" href="/app"><i class="bi bi-grid-1x2 me-2"></i>Visão geral</a></li>
        <li><a class="dropdown-item" href="/app/perfil"><i class="bi bi-person-circle me-2"></i>Meu perfil</a></li>
        <% if (currentUser.role === 'superadmin') { %>
          <li><a class="dropdown-item" href="/app/admin"><i class="bi bi-shield-check me-2"></i>Administração</a></li>
        <% } %>
        <li><hr class="dropdown-divider" /></li>
        <li>
          <form action="/logout" method="POST">
            <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sair da conta</button>
          </form>
        </li>
      </ul>
    </div>
  </div>
</header>
