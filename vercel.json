{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{src/views/**,src/public/**,database/**,node_modules/sql.js/dist/sql-wasm.wasm}"
    }
  },
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
